<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Timer"
            style="@style/SettingsLabel"/>
        <SeekBar
            android:id="@+id/seekTimer"
            android:max="120"
            style="@style/SettingsSeekBar"/>

        <TextView
            android:text="Fade"
            style="@style/SettingsLabel"/>
        <SeekBar
            android:id="@+id/seekFade"
            android:max="60"
            style="@style/SettingsSeekBar"/>

        <TextView
            android:text="Shake"
            style="@style/SettingsLabel"/>
        <SeekBar
            android:id="@+id/seekShake"
            android:max="30"
            style="@style/SettingsSeekBar"/>

        <TextView
            android:text="Font Size"
            style="@style/SettingsLabel"/>
        <SeekBar
            android:id="@+id/seekFont"
            android:max="40"
            style="@style/SettingsSeekBar"/>

        <TextView
            android:text="Paper Color"
            style="@style/SettingsLabel"/>
        <Spinner
            android:id="@+id/colorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/previewText"
            android:text="Sample text preview"
            android:textColor="@color/primaryText"
            android:padding="16dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/resetBtn"
            android:text="Reset to Defaults"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>